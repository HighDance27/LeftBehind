--- !u!114 &1314417999
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1314417998}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e37b8c24cb420114eac10a2232a53a2e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScrollingText
  itemInfo:
  - "Chi\u1EBFc tr\u1EF1c th\u0103ng m\xE0 Solace chi\u1EBFm \u0111\u01B0\u1EE3c
    t\u1EEB b\xE3i bi\u1EC3n ch\u1EC9 \u0111\u1EE7 nhi\xEAn li\u1EC7u \u0111\u1EC3
    \u0111\u01B0a anh tho\xE1t kh\u1ECFi h\xF2n \u0111\u1EA3o. Gi\u1EEFa kh\xF4ng
    trung, \u0111\u1ED9ng c\u01A1 b\u1EAFt \u0111\u1EA7u rung l\u1EAFc d\u1EEF d\u1ED9i
    \u2014 r\xF5 r\xE0ng chi\u1EBFc m\xE1y bay \u0111\xE3 b\u1ECB b\u1ECF qu\xEAn
    t\u1EEB l\xE2u ho\u1EB7c t\u1EEBng b\u1ECB ph\xE1 ho\u1EA1i c\xF3 ch\u1EE7 \u0111\xEDch.
    Solace bu\u1ED9c ph\u1EA3i \u0111\xE1p xu\u1ED1ng v\xF9ng \u0111\u1EA5t g\u1EA7n
    nh\u1EA5t: m\u1ED9t d\u1EA3i sa m\u1EA1c kh\u1EAFc nghi\u1EC7t k\xE9o d\xE0i
    \u0111\u1EBFn t\u1EADn ch\xE2n tr\u1EDDi."
  - "Khi tr\u1EF1c th\u0103ng ch\u1EA1m \u0111\u1EA5t v\xE0 t\u1EAFt h\u1EB3n, anh
    ch\u1EC9 c\xF2n l\u1EA1i gi\xF3 n\xF3ng, c\xE1t b\u1ECFng v\xE0 m\u1ED9t s\u1EF1
    im l\u1EB7ng b\u1EA5t th\u01B0\u1EDDng. Kh\xF4ng c\xF2n r\u1EEBng r\u1EADm \u0111\u1EC3
    \u1EA9n n\u1EA5p, kh\xF4ng c\xF2n b\u1EDD bi\u1EC3n \u0111\u1EC3 tr\u1ED1n ch\u1EA1y
    \u2014 n\u01A1i n\xE0y ph\u01A1i b\xE0y anh tr\u01B0\u1EDBc m\u1ECDi \xE1nh m\u1EAFt
    truy l\xF9ng."
  - "Nh\u01B0ng \u0111i\u1EC1u khi\u1EBFn Solace c\u1EA3nh gi\xE1c nh\u1EA5t kh\xF4ng
    ph\u1EA3i l\xE0 sa m\u1EA1c. M\xE0 l\xE0 d\u1EA5u v\u1EBFt r\xF5 r\xE0ng c\u1EE7a
    nh\u1EEFng to\xE1n l\xEDnh chuy\xEAn nghi\u1EC7p: v\u1ECF \u0111\u1EA1n m\u1EDBi,
    d\u1EA5u b\xE1nh xe, v\xE0 m\u1ED9t b\xE3i \u0111\xE1p t\u1EA1m c\xF2n l\u01B0u
    l\u1EA1i v\u1EC7t b\u1EE5i. \u0110\xE2y kh\xF4ng ph\u1EA3i qu\xE2n b\u1EA3n \u0111\u1ECBa
    \u2014 \u0111\xE2y l\xE0 nh\u1EEFng ng\u01B0\u1EDDi \u0111\u01B0\u1EE3c hu\u1EA5n
    luy\u1EC7n b\xE0i b\u1EA3n. V\xE0 h\u1ECD \u0111\u1EBFn \u0111\xE2y \u0111\u1EC3
    s\u0103n ai \u0111\xF3."
  - "Trong b\u1ED9 t\xE0i li\u1EC7u nh\u1EB7t \u0111\u01B0\u1EE3c \u1EDF b\xE3i bi\u1EC3n,
    Solace \u0111\u1ECDc th\u1EA5y t\xEAn c\u1EE7a m\u1ED9t nh\xF3m l\xEDnh \u0111\xE1nh
    thu\xEA t\u1EEBng h\u1EE3p t\xE1c v\u1EDBi chi\u1EBFn d\u1ECBch Specter\u2026
    r\u1ED3i b\u1ECB \u201Cx\xF3a h\u1ED3 s\u01A1\u201D c\xF9ng th\u1EDDi \u0111i\u1EC3m
    \u0111\u1ED9i c\u1EE7a anh r\xFAt qu\xE2n. N\u1EBFu h\u1ECD \u0111ang l\u1EA7n
    theo h\xE0nh tr\xECnh c\u1EE7a anh, \u0111i\u1EC1u \u0111\xF3 ch\u1EC9 c\xF3
    ngh\u0129a m\u1ED9t \u0111i\u1EC1u: k\u1EBB \u0111\u1EE9ng sau v\u1EE5 ph\u1EA3n
    b\u1ED9i \u0111ang thu\xEA ng\u01B0\u1EDDi d\u1ECDn s\u1EA1ch m\u1ECDi d\u1EA5u
    v\u1EBFt \u2014 k\u1EC3 c\u1EA3 anh."
  - "Sa m\u1EA1c hoang vu tr\u01B0\u1EDBc m\u1EAFt kh\xF4ng ch\u1EC9 l\xE0 th\u1EED
    th\xE1ch sinh t\u1ED3n. N\xF3 l\xE0 chi\u1EBFc b\xECnh \u0111\u1ECBa l\xFD t\u01B0\u1EDFng
    \u0111\u1EC3 nh\u1EEFng k\u1EBB s\u0103n ti\u1EC1n th\u01B0\u1EDFng k\u1EBFt
    th\xFAc c\xF4ng vi\u1EC7c c\u1EE7a m\xECnh.  Solace si\u1EBFt ch\u1EB7t v\u0169
    kh\xED, b\u01B0\u1EDBc v\xE0o v\xF9ng c\xE1t n\xF3ng m\xEAnh m\xF4ng.  Kh\xF4ng
    c\xF2n n\u01A1i n\xE0o \u0111\u1EC3 tr\u1ED1n n\u1EEFa. Ch\u1EC9 c\xF2n ti\u1EBFn
    l\xEAn \u2014 v\xE0 s\u1ED1ng s\xF3t."
  textSpeed: 0.05
  itemInfoText: {fileID: 2054369090}
