--- !u!114 &1314417999
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1314417998}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e37b8c24cb420114eac10a2232a53a2e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScrollingText
  itemInfo:
  - "Chi\u1EBFc xe t\u1EA3i qu\xE2n s\u1EF1 m\xE0 Solace chi\u1EBFm \u0111\u01B0\u1EE3c
    \u0111\xE3 \u0111\u01B0a anh tho\xE1t kh\u1ECFi v\xF2ng ch\u1ED1t \u1EDF khu
    v\u1EF1c c\xE2y c\u1EA7u. Nh\u01B0ng \u0111\u1ED9ng c\u01A1 ch\u1EC9 ch\u1EA1y
    \u0111\u01B0\u1EE3c \u0111\u1EBFn v\xF9ng ven bi\u1EC3n ph\xEDa \u0110\xF4ng
    r\u1ED3i t\u1EAFt l\u1ECBm \u2013 c\xF3 l\u1EBD t\u1EEBng b\u1ECB ph\xE1 ho\u1EA1i
    ho\u1EB7c \u0111\xE3 qu\xE1 c\u0169 k\u1EF9 sau nhi\u1EC1u n\u0103m b\u1ECB b\u1ECF
    r\u01A1i."
  - "Solace bu\u1ED9c ph\u1EA3i b\u1ECF l\u1EA1i ph\u01B0\u01A1ng ti\u1EC7n v\xE0
    cu\u1ED1c b\u1ED9 tr\xEAn n\u1EC1n c\xE1t m\u1EC1m, n\u01A1i gi\xF3 bi\u1EC3n
    mang theo m\xF9i s\u1EAFt g\u1EC9 c\u1EE7a nh\u1EEFng cu\u1ED9c giao tranh c\u0169.
    Tr\u01B0\u1EDBc m\u1EAFt anh l\xE0 m\u1ED9t b\xE3i bi\u1EC3n hoang t\xE0n: x\xE1c
    t\xE0u m\u1EE5c n\xE1t, th\xF9ng ti\u1EBFp t\u1EBF r\u1ED7ng, m\u1EA3nh v\u1EE1
    chi\u1EBFn tranh c\xF2n r\u1EA3i r\xE1c nh\u01B0 ch\u1EE9ng t\xEDch c\u1EE7a
    m\u1ED9t chi\u1EBFn d\u1ECBch b\u1ECB che gi\u1EA5u."
  - "T\u1EA1i \u0111\xE2y, Solace t\xECm th\u1EA5y d\u1EA5u v\u1EBFt cho th\u1EA5y
    l\u1EF1c l\u01B0\u1EE3ng c\u1EE7a anh t\u1EEBng \u0111\u1ED5 b\u1ED9 \u1EDF ch\xEDnh
    khu v\u1EF1c n\xE0y, tr\u01B0\u1EDBc khi r\xFAt lui m\xE0 kh\xF4ng h\u1EC1 b\xE1o
    c\xE1o. Nh\u1EEFng t\xE0i li\u1EC7u r\u01A1i r\u1EDBt c\xF2n l\u1EA1i l\xE0m
    r\xF5 m\u1ED9t \u0111i\u1EC1u: cu\u1ED9c ph\u1EE5c k\xEDch trong r\u1EEBng kh\xF4ng
    ph\u1EA3i ng\u1EABu nhi\xEAn \u2013 m\xE0 c\xF3 b\xE0n tay c\u1EE7a m\u1ED9t
    phe n\u1ED9i b\u1ED9 mu\u1ED1n \u201Cx\xF3a s\u1EA1ch\u201D t\u1EA5t c\u1EA3."
  - "Nh\u01B0ng b\xE3i bi\u1EC3n n\xE0y kh\xF4ng h\u1EC1 v\u1EAFng l\u1EB7ng nh\u01B0
    v\u1EBB ngo\xE0i. Nh\u1EEFng ti\u1EBFng \u0111\u1ED9ng l\u1EA1 v\u1ECDng l\xEAn
    t\u1EEB c\xE1c boongke c\xE1t, v\xE0 d\u1EA5u gi\xE0y m\u1EDBi in tr\xEAn c\xE1t
    cho th\u1EA5y c\xF3 k\u1EBB kh\xE1c \u0111ang s\u0103n l\xF9ng anh."
  - "Solace h\xEDt m\u1ED9t h\u01A1i th\u1EADt s\xE2u, m\u1EAFt h\u01B0\u1EDBng v\u1EC1
    nh\u1EEFng t\xE0n d\u01B0 chi\u1EBFn tranh tr\u01B0\u1EDBc m\u1EB7t.  N\u1EBFu
    mu\u1ED1n t\xECm s\u1EF1 th\u1EADt\u2026 anh ph\u1EA3i v\u01B0\u1EE3t qua b\xE3i
    bi\u1EC3n n\xE0y tr\u01B0\u1EDBc."
  textSpeed: 0.05
  itemInfoText: {fileID: 2054369090}
